{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://termbrio.dev/schemas/release-changelog-entry-v1.json",
  "title": "Termbrio release changelog entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "component",
    "version",
    "channel",
    "status",
    "summary",
    "changes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "component": {
      "enum": [
        "product",
        "plugins"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "channel": {
      "enum": [
        "pilot",
        "preview",
        "stable"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "ready"
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    }
  },
  "$defs": {
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "area",
        "text"
      ],
      "properties": {
        "type": {
          "enum": [
            "added",
            "changed",
            "fixed",
            "deprecated",
            "removed",
            "security"
          ]
        },
        "area": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "providers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "codex",
              "claude"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "changes": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
