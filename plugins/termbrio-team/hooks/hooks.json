{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "tbhookemit auto SessionStart",
            "commandWindows": "tbhookemit.exe auto SessionStart",
            "statusMessage": "Updating Termbrio activity",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tbhookemit auto UserPromptSubmit",
            "commandWindows": "tbhookemit.exe auto UserPromptSubmit",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tbhookemit auto PreToolUse",
            "commandWindows": "tbhookemit.exe auto PreToolUse",
            "timeout": 2
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tbhookemit auto PermissionRequest",
            "commandWindows": "tbhookemit.exe auto PermissionRequest",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tbhookemit auto PostToolUse",
            "commandWindows": "tbhookemit.exe auto PostToolUse",
            "timeout": 2
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tbhookemit auto PermissionDenied",
            "commandWindows": "tbhookemit.exe auto PermissionDenied",
            "timeout": 2
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tbhookemit auto Notification",
            "commandWindows": "tbhookemit.exe auto Notification",
            "timeout": 2
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tbhookemit auto Elicitation",
            "commandWindows": "tbhookemit.exe auto Elicitation",
            "timeout": 2
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tbhookemit auto ElicitationResult",
            "commandWindows": "tbhookemit.exe auto ElicitationResult",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tbhookemit auto Stop",
            "commandWindows": "tbhookemit.exe auto Stop",
            "timeout": 2
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tbhookemit auto SessionEnd",
            "commandWindows": "tbhookemit.exe auto SessionEnd",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
